{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design_brief_v1.schema.json",
  "title": "design_brief_v1",
  "type": "object",
  "required": [
    "title",
    "elevator_pitch",
    "mode",
    "players",
    "duration_minutes",
    "interaction",
    "randomness",
    "success_metrics"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "elevator_pitch": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "beginner",
        "standard",
        "expert"
      ],
      "default": "standard"
    },
    "players": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300
    },
    "complexity": {
      "type": "string",
      "enum": [
        "light",
        "medium",
        "heavy"
      ],
      "default": "medium"
    },
    "interaction": {
      "type": "string",
      "enum": [
        "competitive",
        "co-op",
        "team",
        "semi-coop"
      ]
    },
    "core_player_verbs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "randomness": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "theme": {
      "type": "string"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "component_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "table_space": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "setup_time_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      }
    },
    "success_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 4
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
